# Exclude all dotfiles
.*

# Track .gitignore itself
!.gitignore

# Track this repo's own Claude Code setup (the verification recipe, and any
# development hooks added later). Local session state stays out; the re-ignore
# rules below win because they come last.
!.claude/
.claude/settings.local.json
.claude/log/
.claude/flow/
.claude/.wise-mode
.claude/.terse-mode
.claude/.check-gate

# Python bytecode
__pycache__/
*.py[cod]
